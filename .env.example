# Read-only connection to the EXISTING Panachickal family tree database.
# The chronicle app must NEVER write to this database.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/panachi"

# Where profile/spouse/gallery photos are served from.
# Empty  -> served from THIS app's own public/uploads/people folder (default).
# URL    -> prefix for relative image paths, e.g. the tree app origin
#           (http://localhost:3005) or the tree subdomain in production.
NEXT_PUBLIC_IMAGE_BASE_URL=""
