# Read-only connection to the EXISTING Panachickal family tree database.
# The chronicle app must NEVER write to this database.
# On Hostinger, use the same credentials as the deployed tree app (set them in
# hPanel's Node.js app environment variables, not in git).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/panachi"

# Photos live only on the tree site. Stored paths like /uploads/people/A/A4_1/A4_1-1.jpg
# become https://tree.nuancedor.com/uploads/people/A/A4_1/A4_1-1.jpg.
IMAGE_BASE_URL="https://tree.nuancedor.com"

# Optional read-only listing of the tree's photo folder, so photos without a
# database record still appear. Nothing is copied or changed.
#   Hostinger: /home/u627857774/domains/tree.nuancedor.com/uploads/people
#   Local:     D:\projects\panachickal_tree\public\uploads\people
# Leave empty to use database photos only.
PHOTOS_DIR=""
