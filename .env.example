# Read-only connection to the EXISTING Panachickal family tree database.
# The chronicle app must NEVER write to this database.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/panachi"

# Origin of the tree app that physically serves uploaded photos.
# Relative image paths (e.g. /uploads/people/A/A4/A4-1.jpg) are prefixed with this.
# Dev: the tree app dev server. Prod: the tree subdomain.
NEXT_PUBLIC_IMAGE_BASE_URL="http://localhost:3005"
